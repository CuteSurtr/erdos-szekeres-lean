def support (i : Fin 24) : Finset (Fin 154) := supports[i.val]!
def demand (i : Fin 24) : Nat := (support i).card - 22

theorem checked : ∀ i : Fin 24, pairsOK (block i) = true ∧ growthOK (block i) = true ∧
    (block i).support.toFinset = (support i).image Fin.val := by
  decide +kernel

theorem all_rows {n : ℕ} (c : Configuration n)
    (noCap : ¬ c.HasCap 6)
    (noOctagon : ¬ HasConvexNGon 8 (Finset.univ.image c.point))
    (noJunction : Subsets.NoJunctionOn c.cup (Finset.range n)) (i : Fin 24) :
    demand i ≤ (support i \ c.residualOccupied noCap noOctagon noJunction).card := by
  obtain ⟨pairs, growth, supportEq⟩ := checked i
  exact BlockGeometry.block_hole_bound c noCap noOctagon noJunction
    (block i) pairs growth (support i) supportEq

end ErdosSzekeres.Omission.GeneralResidualBlocks
