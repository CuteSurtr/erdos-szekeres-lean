  "prototype_script": "from pathlib import Path\nimport hashlib,json,sys,time\nimport z3\nname=sys.argv[1]\np=Path('.cache/schroeder-inspect')/(name+'.json')\nd=json.loads(p.read_text()); n=len(d['states']); budget=d['hole_budget']+1\nrows=[(row,len(row)-7) for row in d['cuts']] if name=='balanced' else [(r['support'],r['rhs']) for r in d['constraints']]\nholes=[z3.Bool(f'h_{i}') for i in range(n)]\ns=z3.Solver();s.set(timeout=180000,random_seed=0)\nfor K,a in rows:s.add(z3.PbGe([(holes[i],1) for i in K],a))\ns.add(z3.PbLe([(h,1) for h in holes],budget))\nt=time.monotonic();v=s.check()\nr={'source_doi':'10.5281/zenodo.22842891','source_file':name+'.json','source_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'scope':'Published omission-row relaxation only; no planar geometry or new theorem','states':n,'rows':len(rows),'hole_budget_tested':budget,'status':str(v),'solver':'Z3 '+z3.get_version_string(),'seconds':time.monotonic()-t}\nif v==z3.sat:\n O=[i for i,h in enumerate(holes) if z3.is_true(s.model().eval(h,model_completion=True))]\n assert len(O)<=budget and all(len(set(K)&set(O))>=a for K,a in rows)\n r.update(holes=O,occupied=n-len(O),all_rows_exactly_checked=True)\nelif v==z3.unknown:r['reason']=s.reason_unknown()\nout=Path('.cache/schroeder-inspect')/(name+'-one-step-probe.json')\nassert not out.exists();out.write_text(json.dumps(r,indent=2)+'\\n');print(json.dumps(r))\n",
