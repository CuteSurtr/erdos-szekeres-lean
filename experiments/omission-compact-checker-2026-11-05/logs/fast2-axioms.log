'CompactChecker.checkF2_sound' depends on axioms: [propext, Classical.choice, Quot.sound]
'CompactChecker.checkF2_feas' depends on axioms: [propext, Classical.choice, Quot.sound]
CompactChecker.checkF2_sound : ∀ (c : CompactChecker.FCat) (m n budget base0 base K J k : ℕ),
  CompactChecker.FCat.wf n base0 c = true →
    ∀ (t : CompactChecker.PTree) (mask : List ℕ),
      CompactChecker.checkF2 c m n budget base K J k t mask = true →
        ¬∃ holes,
            (∀ (i : Fin n), holes i ≤ 1) ∧
              (∀ (r : Fin m), c.dem ↑r ≤ ∑ i ∈ CompactChecker.fsupp c n ↑r, holes i) ∧
                ∑ i, holes i ≤ budget ∧
                  (∀ i ∈ CompactChecker.mset n mask 1, holes i = 1) ∧ ∀ i ∈ CompactChecker.mset n mask 2, holes i = 0
