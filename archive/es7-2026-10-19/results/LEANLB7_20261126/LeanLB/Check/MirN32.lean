import LeanLB.Geometry7
import LeanLB.Data.MirN32

/-! Kernel evaluations for `mirN32` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 2 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 32 points. -/
theorem mirN32_len : mirN32Nat.length = 32 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem mirN32_gp : gpOK mirN32Nat = true := by decide +kernel

theorem mirN32_dp_0 : checkFrom 5 mirN32Nat 0 28 = true := by decide +kernel
theorem mirN32_dp_1 : checkFrom 5 mirN32Nat 28 32 = true := by decide +kernel

/-- No anchor starts a chain of 6 left turns: no 7 points in convex position. -/
theorem mirN32_dp : checkAll 5 mirN32Nat = true := by
  apply checkAll_of_checkFrom
  rw [mirN32_len]
  exact (checkFrom_trans (by decide : 0 ≤ 28) (by decide : 28 ≤ 32)
      mirN32_dp_0 mirN32_dp_1)

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem mirN32_link : mirN32Rows.map latXY = mirN32Nat.map (unshift mirN32Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem mirN32_closed : ∀ w ∈ mirN32Rows, reflXY w ∈ mirN32Rows := by decide +kernel

end LeanLB
