import LeanLB.Geometry7
import LeanLB.Data.C4N28

/-! Kernel evaluations for `c4N28` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 1 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 28 points. -/
theorem c4N28_len : c4N28Nat.length = 28 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem c4N28_gp : gpOK c4N28Nat = true := by decide +kernel

theorem c4N28_dp_0 : checkFrom 5 c4N28Nat 0 28 = true := by decide +kernel

/-- No anchor starts a chain of 6 left turns: no 7 points in convex position. -/
theorem c4N28_dp : checkAll 5 c4N28Nat = true := by
  apply checkAll_of_checkFrom
  rw [c4N28_len]
  exact c4N28_dp_0

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem c4N28_link : c4N28Rows.map latXY = c4N28Nat.map (unshift c4N28Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem c4N28_closed : ∀ w ∈ c4N28Rows, rot90XY w ∈ c4N28Rows := by decide +kernel

end LeanLB
