import LeanLB.Geometry7
import LeanLB.Data.C5N31

/-! Kernel evaluations for `c5N31` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 2 ranges. -/

namespace LeanLB.G

set_option maxRecDepth 100000

/-- 31 points. -/
theorem c5N31_len : c5N31L.length = 31 := by decide +kernel

/-- The approximations are certified. -/
theorem c5N31_cert : c5N31L.all (certOK lo5 D5 c5N31Sc c5N31Shift.1 c5N31Shift.2 c5N31Mx) = true := by
  decide +kernel

/-- Every pair ordered, every triple decided. -/
theorem c5N31_gp : gpOK (opA (8 * c5N31Mx + 8)) (abA 1 (2 + 2 * 1)) c5N31L = true := by decide +kernel

theorem c5N31_dp_0 : checkFrom (opA (8 * c5N31Mx + 8)) (abA 1 (2 + 2 * 1)) 5 c5N31L 0 27 = true := by
  decide +kernel
theorem c5N31_dp_1 : checkFrom (opA (8 * c5N31Mx + 8)) (abA 1 (2 + 2 * 1)) 5 c5N31L 27 31 = true := by
  decide +kernel

/-- No anchor starts a chain of 6 left turns. -/
theorem c5N31_dp : checkAll (opA (8 * c5N31Mx + 8)) (abA 1 (2 + 2 * 1)) 5 c5N31L = true := by
  apply checkAll_of_checkFrom
  rw [c5N31_len]
  exact (checkFrom_trans (by decide : 0 ≤ 27) (by decide : 27 ≤ 31)
      c5N31_dp_0 c5N31_dp_1)

/-- The exact coordinates are those of the rows. -/
theorem c5N31_link : c5N31L.map Prod.fst = c5N31Rows.map lat5 := by decide +kernel

/-- The rows are closed under the rotation (multiplication by z, reduced to the basis 1, z, z², z³). -/
theorem c5N31_closed : ∀ w ∈ c5N31Rows, mulZ5 w ∈ c5N31Rows := by decide +kernel

end LeanLB.G
