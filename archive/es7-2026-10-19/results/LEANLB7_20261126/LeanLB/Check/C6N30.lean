import LeanLB.Geometry7
import LeanLB.Data.C6N30

/-! Kernel evaluations for `c6N30` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 1 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 30 points. -/
theorem c6N30_len : c6N30Nat.length = 30 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem c6N30_gp : gpOK c6N30Nat = true := by decide +kernel

theorem c6N30_dp_0 : checkFrom 5 c6N30Nat 0 30 = true := by decide +kernel

/-- No anchor starts a chain of 6 left turns: no 7 points in convex position. -/
theorem c6N30_dp : checkAll 5 c6N30Nat = true := by
  apply checkAll_of_checkFrom
  rw [c6N30_len]
  exact c6N30_dp_0

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem c6N30_link : c6N30Rows.map lat3 = c6N30Nat.map (unshift c6N30Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem c6N30_closed : ∀ w ∈ c6N30Rows, mulZeta3 w ∈ c6N30Rows := by decide +kernel

end LeanLB
