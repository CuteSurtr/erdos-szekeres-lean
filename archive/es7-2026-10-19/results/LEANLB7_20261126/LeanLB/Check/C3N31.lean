import LeanLB.Geometry7
import LeanLB.Data.C3N31

/-! Kernel evaluations for `c3N31` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 2 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 31 points. -/
theorem c3N31_len : c3N31Nat.length = 31 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem c3N31_gp : gpOK c3N31Nat = true := by decide +kernel

theorem c3N31_dp_0 : checkFrom 5 c3N31Nat 0 30 = true := by decide +kernel
theorem c3N31_dp_1 : checkFrom 5 c3N31Nat 30 31 = true := by decide +kernel

/-- No anchor starts a chain of 6 left turns: no 7 points in convex position. -/
theorem c3N31_dp : checkAll 5 c3N31Nat = true := by
  apply checkAll_of_checkFrom
  rw [c3N31_len]
  exact (checkFrom_trans (by decide : 0 ≤ 30) (by decide : 30 ≤ 31)
      c3N31_dp_0 c3N31_dp_1)

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem c3N31_link : c3N31Rows.map lat3 = c3N31Nat.map (unshift c3N31Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem c3N31_closed : ∀ w ∈ c3N31Rows, mulOmega w ∈ c3N31Rows := by decide +kernel

end LeanLB
