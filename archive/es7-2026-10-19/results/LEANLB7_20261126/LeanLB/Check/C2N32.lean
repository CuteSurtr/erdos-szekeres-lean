import LeanLB.Geometry7
import LeanLB.Data.C2N32

/-! Kernel evaluations for `c2N32` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks7.py` (budget 40000); the anchor loop is split into 2 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 32 points. -/
theorem c2N32_len : c2N32Nat.length = 32 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem c2N32_gp : gpOK c2N32Nat = true := by decide +kernel

theorem c2N32_dp_0 : checkFrom 5 c2N32Nat 0 12 = true := by decide +kernel
theorem c2N32_dp_1 : checkFrom 5 c2N32Nat 12 32 = true := by decide +kernel

/-- No anchor starts a chain of 6 left turns: no 7 points in convex position. -/
theorem c2N32_dp : checkAll 5 c2N32Nat = true := by
  apply checkAll_of_checkFrom
  rw [c2N32_len]
  exact (checkFrom_trans (by decide : 0 ≤ 12) (by decide : 12 ≤ 32)
      c2N32_dp_0 c2N32_dp_1)

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem c2N32_link : c2N32Rows.map latXY = c2N32Nat.map (unshift c2N32Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem c2N32_closed : ∀ w ∈ c2N32Rows, negXY w ∈ c2N32Rows := by decide +kernel

end LeanLB
