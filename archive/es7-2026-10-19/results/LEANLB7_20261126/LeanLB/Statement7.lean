import LeanLB.Statement
import LeanLB.Data.C3N31
import LeanLB.Data.C6N30
import LeanLB.Data.C4N28
import LeanLB.Data.C2N32
import LeanLB.Data.MirN32
import LeanLB.Data.C5N31

/-!
# The k = 7 statements (trusted part)

Trusted, together with this file: `ErdosSzekeres/Definitions.lean` (the repository's `Point`,
`GeneralPosition`, `HasConvexNGon`), the definitions `Invariant`, `rotAbout`, `lineRefl`, `unitRoot`,
`cycPoint`, `intPoint` of `LeanLB/Statement.lean` (copied unchanged from LEANLB20261111) and the rows in
`LeanLB/Data/{C3N31,C6N30,C4N28,C2N32,MirN32,C5N31}.lean` (generated by `scripts/gen_data7.py`, which
re-reads the repository's files; `--check` compares byte for byte).

The rows are read as in `SYMMAX/README.md`, "Coordinates":
* `c3_31points.txt`, `c6_30points.txt`: a row `a b` is the point `a + bω`, `ω = e^{2πi/3}` (`cycPoint 3`);
* `c5_31points.txt`: a row `c0 c1 c2 c3` is `c0 + c1 z + c2 z² + c3 z³`, `z = e^{2πi/5}` (`cycPoint 5`;
  the missing coefficient of `z⁴` counts as `0`);
* `c4_28points.txt`, `mirror_32points.txt`, `SYM2/sym7_32points.txt`: a row `x y` is the point `(x, y)`
  (`intPoint`).
-/

namespace LeanLB

open ErdosSzekeres

/-- `SYMMAX/c3_31points.txt`: 3-fold, 31 points (with the centre). -/
noncomputable def setC3N31 : Finset Point := (c3N31Rows.map (cycPoint 3)).toFinset

/-- `SYMMAX/c6_30points.txt`: 6-fold, 30 points (Eisenstein coordinates). -/
noncomputable def setC6N30 : Finset Point := (c6N30Rows.map (cycPoint 3)).toFinset

/-- `SYMMAX/c4_28points.txt`: 4-fold, 28 points. -/
noncomputable def setC4N28 : Finset Point := (c4N28Rows.map intPoint).toFinset

/-- `SYM2/sym7_32points.txt`: half-turn, 32 points. -/
noncomputable def setC2N32 : Finset Point := (c2N32Rows.map intPoint).toFinset

/-- `SYMMAX/mirror_32points.txt`: mirror symmetric in the line `x = 0`, 32 points. -/
noncomputable def setMirN32 : Finset Point := (mirN32Rows.map intPoint).toFinset

/-- `SYMMAX/c5_31points.txt`: 5-fold, 31 points (with the centre). -/
noncomputable def setC5N31 : Finset Point := (c5N31Rows.map (cycPoint 5)).toFinset

end LeanLB
