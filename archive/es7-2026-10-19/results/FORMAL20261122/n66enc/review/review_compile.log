def OmissionZRow.N66Bound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : Configuration n),
    ¬c.HasCap 6 → ¬c.HasCup 6 → ¬HasConvexNGon 8 (Finset.image c.point Finset.univ) → n ≤ B
def N66Enc.CubesUnsat132 : Prop :=
∀ c ∈ N66Enc.leaves132, ¬EncB.DimacsSatisfiable (N66Enc.fullCnf N66Enc.R0 c)
def N66Enc.fullCnf : List (List (Fin 70)) → N66Enc.Cube → List (List ℤ) :=
fun R c => List.map N66Enc.toDimacs (N66Enc.fullS R c)
def N66Enc.fullS : List (List (Fin 70)) → N66Enc.Cube → List (List N66Enc.SLit) :=
fun R c =>
  N66Enc.eagerStream () ++ N66Enc.quadStream ++ N66Enc.fixedUnits ++ List.map N66Enc.cubeUnit c ++
        List.map N66Enc.rowClause R ++
      N66Enc.cardClauses ++
