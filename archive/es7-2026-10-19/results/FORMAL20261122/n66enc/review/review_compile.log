    (generalPosition : ∀ (i j k : Fin n), i < j → j < k → orient (point i) (point j) (point k) ≠ 0) : Configuration n
def ErdosSzekeres.Omission.Configuration.cup : {n : ℕ} → Configuration n → ℕ → ℕ → ℕ → Bool :=
fun {n} c i j k =>
  if h : i < n ∧ j < n ∧ k < n then decide (0 < orient (c.point ⟨i, ⋯⟩) (c.point ⟨j, ⋯⟩) (c.point ⟨k, ⋯⟩)) else false
def ErdosSzekeres.Omission.Configuration.HasCap : {n : ℕ} → Configuration n → ℕ → Prop :=
fun {n} c k =>
  ∃ f, StrictMono f ∧ ∀ (i j l : Fin k), i < j → j < l → orient (c.point (f i)) (c.point (f j)) (c.point (f l)) < 0
def ErdosSzekeres.Omission.Configuration.HasCup : {n : ℕ} → Configuration n → ℕ → Prop :=
fun {n} c k =>
  ∃ f, StrictMono f ∧ ∀ (i j l : Fin k), i < j → j < l → 0 < orient (c.point (f i)) (c.point (f j)) (c.point (f l))
def ErdosSzekeres.HasConvexNGon : ℕ → Finset Point → Prop :=
fun n s => ∃ t ⊆ s, t.card = n ∧ ConvexPosition t
def ErdosSzekeres.ConvexPosition : Finset Point → Prop :=
fun s => ConvexIndependent ℝ fun p => ↑p
def ErdosSzekeres.orient.{u_1} : {R : Type u_1} → [CommRing R] → (Fin 2 → R) → (Fin 2 → R) → (Fin 2 → R) → R :=
fun {R} [CommRing R] a b c => (b 0 - a 0) * (c 1 - a 1) - (b 1 - a 1) * (c 0 - a 0)
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = true ∨ l < 0 ∧ ν l.natAbs = false
def EncB.LitSat : (ℕ → Bool) → ℤ → Prop :=
fun ν z => 0 < z ∧ ν z.natAbs = true ∨ z < 0 ∧ ν z.natAbs = false
