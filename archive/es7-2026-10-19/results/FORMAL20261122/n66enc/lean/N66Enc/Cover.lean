import N66Enc.Clauses

/-!
# N66Enc.Cover: the split tree of the level-14 campaign (Std-only)

`tree14` is the 200-node split tree of `p2/c14/campaign_status.json` (generated by the session's script from the
`lits`/`split_on`/`children` fields; DESIGN.md §3): the first six levels split on states 25, 12, 16, 29, 17, 37,
then 68 re-splits; children are (state occupied, state hole) in that order. `leaves tree14` lists the 132 leaf
cubes in depth-first order (occupied child first); each cube lists its literals from the root.
-/

namespace N66Enc

inductive SplitTree
  | leaf
  | node (s : Fin 70) (occ hole : SplitTree)

/-- A cube: `(s, true)` = state s occupied (`+sel s`), `(s, false)` = hole (`-sel s`). -/
abbrev Cube := List (Fin 70 × Bool)

/-- The leaf cubes below a node reached by the literals `pre` (in root-to-node order). -/
def SplitTree.leavesFrom : SplitTree → Cube → List Cube
  | .leaf, pre => [pre]
  | .node s occ hole, pre => occ.leavesFrom (pre ++ [(s, true)]) ++ hole.leavesFrom (pre ++ [(s, false)])

def SplitTree.leaves (t : SplitTree) : List Cube := t.leavesFrom []

def tree14 : SplitTree :=
  (.node 25 (.node 12 (.node 16 (.node 29 (.node 17 (.node 37 (.node 40 (.node 52 (.node 46 (.node 44 (.node 45 (.node 39 .leaf .leaf) .leaf) .leaf) (.node 44 .leaf .leaf)) (.node 46 (.node 44 .leaf .leaf) .leaf)) (.node 52 (.node 46 (.node 44 .leaf .leaf) .leaf) .leaf)) .leaf) (.node 37 (.node 40 (.node 52 (.node 46 .leaf .leaf) .leaf) .leaf) (.node 23 .leaf .leaf))) (.node 17 (.node 37 (.node 40 (.node 52 (.node 46 .leaf .leaf) .leaf) (.node 52 (.node 46 .leaf .leaf) .leaf)) (.node 23 (.node 49 .leaf .leaf) .leaf)) (.node 37 (.node 23 (.node 49 .leaf .leaf) (.node 49 .leaf .leaf)) .leaf))) (.node 29 (.node 17 (.node 37 (.node 40 (.node 52 (.node 46 .leaf .leaf) .leaf) .leaf) (.node 23 .leaf .leaf)) (.node 37 (.node 23 .leaf .leaf) .leaf)) (.node 17 (.node 37 (.node 23 (.node 40 (.node 52 .leaf .leaf) .leaf) (.node 49 (.node 44 .leaf .leaf) .leaf)) (.node 23 (.node 49 .leaf .leaf) .leaf)) (.node 37 (.node 23 (.node 49 (.node 44 .leaf .leaf) .leaf) .leaf) .leaf)))) (.node 16 (.node 29 (.node 17 (.node 37 (.node 40 (.node 52 (.node 46 .leaf .leaf) .leaf) .leaf) (.node 23 .leaf .leaf)) (.node 37 (.node 23 .leaf .leaf) .leaf)) (.node 17 (.node 37 (.node 23 (.node 40 (.node 52 .leaf .leaf) .leaf) (.node 49 (.node 44 .leaf .leaf) .leaf)) .leaf) (.node 37 (.node 23 (.node 49 (.node 44 .leaf .leaf) .leaf) (.node 49 .leaf .leaf)) .leaf))) (.node 29 (.node 17 (.node 37 (.node 23 .leaf .leaf) .leaf) (.node 37 (.node 23 .leaf .leaf) .leaf)) (.node 17 (.node 37 (.node 23 (.node 49 (.node 44 .leaf .leaf) .leaf) .leaf) .leaf) (.node 37 .leaf .leaf))))) (.node 12 (.node 16 (.node 29 (.node 17 (.node 37 .leaf .leaf) (.node 37 (.node 23 .leaf .leaf) .leaf)) (.node 17 (.node 37 (.node 23 .leaf .leaf) .leaf) (.node 37 .leaf .leaf))) (.node 29 (.node 17 (.node 37 (.node 23 .leaf .leaf) .leaf) (.node 37 .leaf .leaf)) (.node 17 (.node 37 (.node 23 (.node 49 .leaf .leaf) .leaf) .leaf) (.node 37 .leaf .leaf)))) (.node 16 (.node 29 (.node 17 (.node 37 (.node 23 .leaf .leaf) .leaf) (.node 37 .leaf .leaf)) (.node 17 (.node 37 (.node 23 (.node 49 .leaf .leaf) .leaf) .leaf) (.node 37 .leaf .leaf))) (.node 29 (.node 17 (.node 37 .leaf .leaf) (.node 37 .leaf .leaf)) (.node 17 (.node 37 .leaf .leaf) (.node 37 .leaf .leaf))))))

/-- The 132 leaves of the campaign (all certified). -/
def leaves132 : List Cube := tree14.leaves

end N66Enc
