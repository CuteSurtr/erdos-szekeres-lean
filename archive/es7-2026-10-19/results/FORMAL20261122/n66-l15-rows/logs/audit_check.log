def N66R15Enc.toFin70 : ℕ → Fin 70 :=
fun x => ⟨x % 70, ⋯⟩
def N66E15.fullCnf : List (List (Fin 70)) → N66E15.Cube → List (List ℤ) :=
fun R c => List.map N66E15.toDimacs (N66E15.fullS R c)
def N66E15.fullS : List (List (Fin 70)) → N66E15.Cube → List (List N66E15.SLit) :=
fun R c =>
  N66E15.eagerStream () ++ N66E15.quadStream ++ N66E15.fixedUnits ++ List.map N66E15.cubeUnit c ++
        List.map N66E15.rowClause R ++
      N66E15.cardClauses ++
    N66E15.sbClauses
def N66G15.RowsValid : List (List (Fin 70)) → Prop :=
fun R => ∀ T ∈ R, N66G15.RowValid T
def N66G15.RowValid : List (Fin 70) → Prop :=
fun T => ∀ (n : ℕ) (c : Configuration n), N66G15.InClass c → ∃ s ∈ T, ¬N66G15.n66Occ c.cup n s
def N66G15.InClass : {n : ℕ} → Configuration n → Prop :=
fun {n} c => ¬c.HasCap 6 ∧ ¬c.HasCup 6 ∧ ¬HasConvexNGon 8 (Finset.image c.point Finset.univ)
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = true ∨ l < 0 ∧ ν l.natAbs = false
