import V182Chk.WalkA
import V182Chk.WalkB

/-! # V182Chk.Walk: the walk check for every start mask, and its use (generated by tools/gen_walk.py) -/

namespace V182Geo

theorem walk_all (a : Nat) (ha : a < 256) : walkBody a = true := by
  if h0 : a < 23 then exact walk_c0 a h0 (by omega) else
  if h1 : a < 32 then exact walk_c1 a h1 (by omega) else
  if h2 : a < 45 then exact walk_c2 a h2 (by omega) else
  if h3 : a < 54 then exact walk_c3 a h3 (by omega) else
  if h4 : a < 62 then exact walk_c4 a h4 (by omega) else
  if h5 : a < 76 then exact walk_c5 a h5 (by omega) else
  if h6 : a < 85 then exact walk_c6 a h6 (by omega) else
  if h7 : a < 93 then exact walk_c7 a h7 (by omega) else
  if h8 : a < 103 then exact walk_c8 a h8 (by omega) else
  if h9 : a < 111 then exact walk_c9 a h9 (by omega) else
  if h10 : a < 121 then exact walk_c10 a h10 (by omega) else
  if h11 : a < 138 then exact walk_c11 a h11 (by omega) else
  if h12 : a < 147 then exact walk_c12 a h12 (by omega) else
  if h13 : a < 155 then exact walk_c13 a h13 (by omega) else
  if h14 : a < 165 then exact walk_c14 a h14 (by omega) else
  if h15 : a < 173 then exact walk_c15 a h15 (by omega) else
  if h16 : a < 182 then exact walk_c16 a h16 (by omega) else
  if h17 : a < 196 then exact walk_c17 a h17 (by omega) else
  if h18 : a < 204 then exact walk_c18 a h18 (by omega) else
  if h19 : a < 213 then exact walk_c19 a h19 (by omega) else
  if h20 : a < 226 then exact walk_c20 a h20 (by omega) else
  if h21 : a < 235 then exact walk_c21 a h21 (by omega) else
  exact walk_c22 a ha (by omega)

theorem walk_spec {a b c d i j k : Nat} (ha : a < 256) (hi : i < 8) (hj : j < 8) (hk : k < 8)
    (hb : b = a ^^^ 1 <<< i) (hc : c = b ^^^ 1 <<< j) (hd : d = c ^^^ 1 <<< k)
    (hva : isV a = true) (hvb : isV b = true) (hvc : isV c = true) (hvd : isV d = true)
    (hac : a ≠ c) (hbd : b ≠ d) (h1 : onebit (d ^^^ a) = true) : rainbow4 a b c d = true := by
  subst hb hc hd
  have hac' : (a != a ^^^ 1 <<< i ^^^ 1 <<< j) = true := bne_iff_ne.2 hac
  have hbd' : (a ^^^ 1 <<< i != a ^^^ 1 <<< i ^^^ 1 <<< j ^^^ 1 <<< k) = true := bne_iff_ne.2 hbd
  have h2 := walk_all a ha
  unfold walkBody at h2
  rw [hva, Bool.not_true, Bool.false_or, List.all_eq_true] at h2
  have h3 := h2 i (List.mem_range.2 hi)
  rw [List.all_eq_true] at h3
  have h4 := h3 j (List.mem_range.2 hj)
  rw [List.all_eq_true] at h4
  have h5 := h4 k (List.mem_range.2 hk)
  rw [hvb, hvc, hvd, hac', hbd', h1] at h5
  simpa using h5

end V182Geo
