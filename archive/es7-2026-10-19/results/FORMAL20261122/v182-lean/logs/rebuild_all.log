    (ne_cd : c ≠ d) (ab : G.Adj a b) (bc : G.Adj b c) (cd : G.Adj c d) (da : G.Adj d a) : IsFourCycle a b c d
def V182Geo.G : SimpleGraph V :=
{ Adj := Adj, symm := G._proof_2, loopless := G._proof_3 }
def V182Geo.Adj : V → V → Prop :=
fun u v => ↑u ⊆ ↑v ∧ (↑v).card = (↑u).card + 1 ∨ ↑v ⊆ ↑u ∧ (↑u).card = (↑v).card + 1
@[reducible] def V182Geo.V : Type :=
{ s // 3 ≤ s.card ∧ s.card ≤ 5 }
