∀ q ∈ pieces, ∀ (nv : ℕ) (F : List (List ℤ)), EncB.parseDimacs (pieceText q) = some (nv, F) → ¬EncB.DimacsSatisfiable F
def V182Geo.RainbowColorable : ℕ → Prop :=
fun k => ∃ col, IsRainbow col
def V182Geo.IsRainbow.{u_1} : {α : Type u_1} → (↑G.edgeSet → α) → Prop :=
fun {α} col =>
  ∀ (a b c d : V) (h : IsFourCycle a b c d),
    [col ⟨s(a, b), ⋯⟩, col ⟨s(b, c), ⋯⟩, col ⟨s(c, d), ⋯⟩, col ⟨s(d, a), ⋯⟩].Nodup
