import RowGeo.Sem

/-!
# RowGeo.Eight: eight x-sorted points with all quadruples "convex" do not exist in a model (generated cases)

`no_eight`: if every x-sorted quadruple `a < b < c < d` of eight points `q 0 < … < q 7` of a `Model` satisfies
`cup abc = cup abd` and `cup acd = cup bcd` (the convex patterns of an x-sorted quadruple under the signotope
condition), then every triple's color is that of its middle point `b` against the ends: `cup a b c = cup (q 0) b
(q 7)` (`rule8`). The six middle points split into an upper part (cap color) and a lower part (cup color). Four in
one part give a 6-cap or 6-cup (excluded by `noCap6`/`noCup6`); otherwise both parts have three points, a 5-cap and a
5-cup from `q 0` to `q 7` (excluded by `noCapCup55`). The 64 sign patterns are spelled out (generated by
tools/gen_eight.py).
-/

namespace RowGeo
open N66Geo ErdosSzekeres ErdosSzekeres.Omission ErdosSzekeres.Omission.ActualRanks

theorem ep6 (cup : ℕ → ℕ → ℕ → Bool) (col : Bool) {x0 x1 x2 x3 x4 x5 : ℕ} (h01 : x0 < x1) (h12 : x1 < x2)
    (h23 : x2 < x3) (h34 : x3 < x4) (h45 : x4 < x5) (c1 : cup x0 x1 x2 = col) (c2 : cup x1 x2 x3 = col)
    (c3 : cup x2 x3 x4 = col) (c4 : cup x3 x4 x5 = col) : EndingPath cup col x4 x5 6 :=
  .step (.step (.step (.step (.pair h01) h12 c1) h23 c2) h34 c3) h45 c4

theorem se5 (cup : ℕ → ℕ → ℕ → Bool) (col : Bool) {x0 x1 x2 x3 x4 : ℕ} (h01 : x0 < x1) (h12 : x1 < x2)
    (h23 : x2 < x3) (h34 : x3 < x4) (c1 : cup x0 x1 x2 = col) (c2 : cup x1 x2 x3 = col)
    (c3 : cup x2 x3 x4 = col) : SEPath cup col x0 x3 x4 5 :=
  .step (.step (.step (.two h01) h12 c1) h23 c2) h34 c3

theorem rule8 (M : Model) (q : Fin 8 → ℕ)
    (H : ∀ i j k l : Fin 8, i < j → j < k → k < l →
      M.cup (q i) (q j) (q k) = M.cup (q i) (q j) (q l) ∧ M.cup (q i) (q k) (q l) = M.cup (q j) (q k) (q l)) :
    ∀ i j k : Fin 8, i < j → j < k → M.cup (q i) (q j) (q k) = M.cup (q 0) (q j) (q 7) := by
  intro i j k hij hjk
  have s1 : M.cup (q i) (q j) (q k) = M.cup (q 0) (q j) (q k) := by
    by_cases hi : i = 0
    · subst hi; rfl
    · exact ((H 0 i j k ((by decide : ∀ x : Fin 8, x ≠ 0 → 0 < x) i hi) hij hjk).2).symm
  have s2 : M.cup (q 0) (q j) (q k) = M.cup (q 0) (q j) (q 7) := by
    by_cases hk : k = 7
    · subst hk; rfl
    · exact (H 0 j k 7 ((by decide : ∀ x y : Fin 8, x < y → 0 < y) i j hij) hjk
        ((by decide : ∀ x : Fin 8, x ≠ 7 → x < 7) k hk)).1
  exact s1.trans s2

