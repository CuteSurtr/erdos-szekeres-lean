def RowGeo.RowCertsUnsat : Prop :=
(∀ t ∈ RowEnc.templates, ¬EncB.DimacsSatisfiable (RowEnc.certCnf t)) ∧
  ∀ k ∈ RowEnc.cores, ¬EncB.DimacsSatisfiable (RowEnc.certCnf k)
def RowGeo.R0Parse : Prop :=
N66Enc.R0 = RowGeo.R1
def RowGeo.R1 : List (List (Fin 70)) :=
List.map (fun x => List.map RowGeo.toFin70 x) RowChk.R1nat
def RowGeo.toFin70 : ℕ → Fin 70 :=
fun x => ⟨x % 70, ⋯⟩
def RowChk.R1nat : List (List ℕ) :=
List.flatMap Prod.fst RowChk.rowChunks
def RowEnc.certCnf : RowEnc.Cert → List (List ℤ) :=
fun t =>
  have m := EncB.numberMap (RowEnc.allocCodes t.n);
  List.map (fun cl => List.map (RowEnc.toLit m) cl) (RowEnc.clsS t)
def RowEnc.certText : RowEnc.Cert → String :=
fun t => EncB.render (RowEnc.nvOf t.n) (RowEnc.certCnf t)
def RowEnc.subCnfChecked : RowEnc.Cert → List ℕ → Option (List (List ℤ)) :=
fun t idx =>
  have A := (RowEnc.certCnf t).toArray;
  List.mapM (fun i => A[i]?) idx
inductive RowEnc.Cert : Type
number of parameters: 0
constructors:
RowEnc.Cert.tmpl : ℕ → List RowEnc.Test → Option (List (List ℕ)) → RowEnc.Cert
RowEnc.Cert.core : List (Fin 70) → Option (List (List ℕ)) → RowEnc.Cert
def RowEnc.nvOf : ℕ → ℕ :=
fun n => (RowEnc.alloc n).length
def RowEnc.certOk : RowEnc.Cert → Bool :=
fun x =>
  match x with
  | RowEnc.Cert.tmpl n ts o => decide (n ≤ 32) && ts.all (RowEnc.testOk n) && RowEnc.octsOk n o
  | RowEnc.Cert.core S o => decide (S.length ≤ 32) && RowEnc.octsOk S.length o
def RowChk.coreOk : RowEnc.Cert → Bool :=
fun k => RowEnc.certOk k && RowEnc.strictUp (RowChk.coreStates k)
def N66Geo.RowsValid : List (List (Fin 70)) → Prop :=
fun R => ∀ T ∈ R, N66Geo.RowValid T
def N66Geo.RowValid : List (Fin 70) → Prop :=
fun T => ∀ (n : ℕ) (c : Configuration n), N66Geo.InClass c → ∃ s ∈ T, ¬N66Geo.n66Occ c.cup n s
def N66Geo.InClass : {n : ℕ} → Configuration n → Prop :=
fun {n} c => ¬c.HasCap 6 ∧ ¬c.HasCup 6 ∧ ¬HasConvexNGon 8 (Finset.image c.point Finset.univ)
def N66Geo.n66Occ : (ℕ → ℕ → ℕ → Bool) → ℕ → Fin 70 → Prop :=
fun cup n s => ∃ v < n, N66Geo.idxOf cup v = ↑s
def N66Geo.idxOf : (ℕ → ℕ → ℕ → Bool) → ℕ → ℕ :=
fun cup v => List.idxOf (N66Geo.profOf cup v) N66Enc.stateList
def N66Geo.profOf : (ℕ → ℕ → ℕ → Bool) → ℕ → N66Enc.Prof :=
fun cup v => (column cup v 0, column cup v 1, column cup v 2, column cup v 3)
def N66Enc.CubesUnsat132 : Prop :=
∀ c ∈ N66Enc.leaves132, ¬EncB.DimacsSatisfiable (N66Enc.fullCnf N66Enc.R0 c)
@[irreducible] def N66Enc.R0 : List (List (Fin 70)) :=
N66Enc.parseRows N66Enc.rowsText
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = true ∨ l < 0 ∧ ν l.natAbs = false
def OmissionZRow.N66Bound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : Configuration n),
    ¬c.HasCap 6 → ¬c.HasCup 6 → ¬HasConvexNGon 8 (Finset.image c.point Finset.univ) → n ≤ B
