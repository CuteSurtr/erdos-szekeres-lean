=== B7 DEFINITIONS
def ErdosSzekeres.ForcesConvexNGon : ℕ → ℕ → Prop :=
fun N n =>
  ∀ (s : Finset ErdosSzekeres.Point), ErdosSzekeres.GeneralPosition s → N ≤ s.card → ErdosSzekeres.HasConvexNGon n s
def ErdosSzekeres.HasConvexNGon : ℕ → Finset ErdosSzekeres.Point → Prop :=
fun n s => ∃ t ⊆ s, t.card = n ∧ ErdosSzekeres.ConvexPosition t
def ErdosSzekeres.GeneralPosition : Finset ErdosSzekeres.Point → Prop :=
fun s => ∀ a ∈ s, ∀ b ∈ s, ∀ c ∈ s, a ≠ b → a ≠ c → b ≠ c → ¬Collinear ℝ {a, b, c}
def ErdosSzekeres.ConvexPosition : Finset ErdosSzekeres.Point → Prop :=
fun s => ConvexIndependent ℝ fun p => ↑p
def ErdosSzekeres.Omission.Partition.ResidualBound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : ErdosSzekeres.Omission.Configuration n),
    ¬c.HasCap 6 →
      ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ) →
        ErdosSzekeres.Omission.Subsets.NoJunctionOn c.cup (Finset.range n) → n ≤ B
def OmissionZRow.N66Bound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : ErdosSzekeres.Omission.Configuration n),
    ¬c.HasCap 6 → ¬c.HasCup 6 → ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ) → n ≤ B
def N66R15Enc.CubesUnsat105R : Prop :=
∀ c ∈ N66E15.leaves105, ¬EncB.DimacsSatisfiable (N66E15.fullCnf N66R15Enc.R1_15 c)
def N66R15Geo.RowCertsUnsat : Prop :=
(∀ t ∈ N66R15Enc.templates, ¬EncB.DimacsSatisfiable (N66R15Enc.certCnf t)) ∧
  ∀ k ∈ N66R15Enc.cores, ¬EncB.DimacsSatisfiable (N66R15Enc.certCnf k)
def N66E15.leaves105 : List N66E15.Cube :=
N66E15.tree15.leaves
def N66E15.fullCnf : List (List (Fin 70)) → N66E15.Cube → List (List ℤ) :=
fun R c => List.map N66E15.toDimacs (N66E15.fullS R c)
def N66R15Enc.R1_15 : List (List (Fin 70)) :=
List.map (fun x => List.map N66R15Enc.toFin70 x) N66R15Enc.R1nat15
def N66R15Enc.R1nat15 : List (List ℕ) :=
N66R15Enc.rowsAll.flatten
def N66R15Enc.certCnf : N66R15Enc.Cert → List (List ℤ) :=
fun t =>
  have m := EncB.numberMap (N66R15Enc.allocCodes t.n);
  List.map (fun cl => List.map (N66R15Enc.toLit m) cl) (N66R15Enc.clsS t)
def RowGeo.RowsTextUnsat : List (List ℕ) → Prop :=
fun rows =>
  ∀ s ∈ rows,
    ∀ (nv : ℕ) (F : List (List ℤ)),
      EncB.parseDimacsBytes (RowEnc.rowText s).toUTF8.data.toList = Option.some (nv, F) → ¬EncB.DimacsSatisfiable F
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = Bool.true ∨ l < 0 ∧ ν l.natAbs = Bool.false
def Res118.ResSliceExcludes : List (List ℕ) → ℕ → ℕ → Prop :=
fun rows B T =>
  ¬∃ holes,
      (∀ (i : Fin 154), holes i ≤ 1) ∧
        holes 0 = 0 ∧
          (∀ (r : Fin 2650),
              OmissionResidual32Bridge2650.demand2650 r ≤ ∑ i ∈ OmissionResidual32Bridge2650.support2650 r, holes i) ∧
            T ≤ ∑ i ∈ Res118.F, holes i ∧
              B - T ≤ ∑ i ∈ Res118.Lo, holes i ∧ (∀ s ∈ rows, 1 ≤ ∑ i ∈ Res118.lsupp s, holes i) ∧ ∑ i, holes i ≤ B
def OmissionBalancedZZsF.ExcludesHoleBudgetZZsF : ℕ → Prop :=
fun budget =>
  ¬∃ holes,
      holes 0 = 0 ∧
        holes 1 = 0 ∧
          (∀ (i : Fin 252), holes i ≤ 1) ∧
            (∀ (r : Fin 2685), OmissionBalanced.demand r ≤ ∑ i ∈ OmissionBalanced.support r, holes i) ∧
              (∀ (r : Fin 446), BalancedCoverCutsV2.demand r ≤ ∑ i ∈ BalancedCoverCutsV2.support r, holes i) ∧
                15 ≤ ∑ i ∈ OmissionZRow.Z, holes i ∧ 15 ≤ ∑ i ∈ OmissionZStarRow.Zs, holes i ∧ ∑ i, holes i ≤ budget
def OmissionBalancedZZsN.ExcludesHoleBudgetZZsN : ℕ → ℕ → Prop :=
fun r budget =>
  ¬∃ holes,
      holes 0 = 0 ∧
        holes 1 = 0 ∧
          (∀ (i : Fin 252), holes i ≤ 1) ∧
