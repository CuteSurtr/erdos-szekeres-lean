def RowGeo.RowsUnsat : List (List ℕ) → Prop :=
fun rows => ∀ s ∈ rows, ¬EncB.DimacsSatisfiable (RowEnc.rowCnf s)
def RowGeo.RowsTextUnsat : List (List ℕ) → Prop :=
fun rows =>
  ∀ s ∈ rows,
    ∀ (nv : ℕ) (F : List (List ℤ)),
      EncB.parseDimacsBytes (RowEnc.rowText s).toUTF8.data.toList = Option.some (nv, F) → ¬EncB.DimacsSatisfiable F
def RowGeo.WF : List ℕ → Prop :=
fun S => List.Pairwise (fun x1 x2 => x1 < x2) S ∧ (∀ x ∈ S, x < 154) ∧ S.length ≤ 16 ∧ 0 < S.length
def RowGeo.statesOf : (S : List ℕ) → (∀ x ∈ S, x < 154) → Fin S.length → Fin 154 :=
fun S h i => ⟨S[↑i], ⋯⟩
def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = Bool.true ∨ l < 0 ∧ ν l.natAbs = Bool.false
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.parseDimacsBytes : List UInt8 → Option (ℕ × List (List ℤ)) :=
fun bs => EncB.parseDimacsChars (List.map (fun b => Char.ofNat b.toNat) bs)
def EncB.parseDimacsChars : List Char → Option (ℕ × List (List ℤ)) :=
fun cs =>
  match EncB.stripPrefix ['p', ' ', 'c', 'n', 'f', ' '] cs with
  | Option.none => Option.none
  | Option.some r1 =>
    match EncB.parseNatTerm ' ' r1 with
    | Option.none => Option.none
    | Option.some (nv, r2) =>
      match EncB.parseNatTerm '\n' r2 with
      | Option.none => Option.none
      | Option.some (nc, r3) =>
        match EncB.runBody nv { mode := EncB.LineMode.start, cur := [], done := [] } r3 with
        | Option.none => Option.none
        | Option.some st =>
          if st.mode = EncB.LineMode.start ∧ st.done.length = nc then Option.some (nv, st.done.reverse) else Option.none
def EncB.render : ℕ → List (List ℤ) → String :=
fun nv F => EncB.headerR nv F.length ++ EncB.bodyR F
def RowEnc.rowText : List ℕ → String :=
fun S => EncB.render (RowEnc.rowNv S) (RowEnc.rowCnf S)
def RowEnc.rowCnf : List ℕ → List (List ℤ) :=
fun S =>
  have L := RowEnc.allocCodes S.length;
  have M := EncB.numberMap L;
  List.filterMap (RowEnc.finish M L.length) (RowEnc.rawClauses S)
def RowEnc.rowNv : List ℕ → ℕ :=
fun S => (RowEnc.allocCodes S.length).length
def Res118.ValidUnitRow : List ℕ → Prop :=
fun s =>
  ∀ (n : ℕ) (c : ErdosSzekeres.Omission.Configuration n) (noCap : ¬c.HasCap 6)
    (noOctagon : ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ))
    (noJunction : ErdosSzekeres.Omission.Subsets.NoJunctionOn c.cup (Finset.range n)),
    0 < n →
      1 ≤ ∑ i ∈ Res118.lsupp s, OmissionResidual32Transfer.holesOf (c.residualOccupied noCap noOctagon noJunction) i
def Res118.BlockValid : List (List ℕ) → Prop :=
fun rows => ∀ s ∈ rows, Res118.ValidUnitRow s
def Res118.lsupp : List ℕ → Finset (Fin 154) :=
fun s => {i | ↑i ∈ s}
def Res118.ResSliceExcludes : List (List ℕ) → ℕ → ℕ → Prop :=
fun rows B T =>
  ¬∃ holes,
      (∀ (i : Fin 154), holes i ≤ 1) ∧
        holes 0 = 0 ∧
          (∀ (r : Fin 2650),
              OmissionResidual32Bridge2650.demand2650 r ≤ ∑ i ∈ OmissionResidual32Bridge2650.support2650 r, holes i) ∧
            T ≤ ∑ i ∈ Res118.F, holes i ∧
              B - T ≤ ∑ i ∈ Res118.Lo, holes i ∧ (∀ s ∈ rows, 1 ≤ ∑ i ∈ Res118.lsupp s, holes i) ∧ ∑ i, holes i ≤ B
def OmissionResidual32Transfer.holesOf : Finset (Fin 154) → Fin 154 → ℕ :=
fun occupied i => if i ∈ occupied then 0 else 1
def ErdosSzekeres.Omission.Partition.ResidualBound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : ErdosSzekeres.Omission.Configuration n),
    ¬c.HasCap 6 →
      ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ) →
        ErdosSzekeres.Omission.Subsets.NoJunctionOn c.cup (Finset.range n) → n ≤ B
def OmissionZRow.N66Bound : ℕ → Prop :=
fun B =>
  ∀ (n : ℕ) (c : ErdosSzekeres.Omission.Configuration n),
    ¬c.HasCap 6 → ¬c.HasCup 6 → ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ) → n ≤ B
def ErdosSzekeres.Omission.Configuration.residualOccupied : {n : ℕ} →
  (c : ErdosSzekeres.Omission.Configuration n) →
    ¬c.HasCap 6 →
      ¬ErdosSzekeres.HasConvexNGon 8 (Finset.image c.point Finset.univ) →
        ErdosSzekeres.Omission.Subsets.NoJunctionOn c.cup (Finset.range n) → Finset (Fin 154) :=
fun {n} c noCap noOctagon noJunction => Finset.image (c.residualOwner noCap noOctagon noJunction) Finset.univ
