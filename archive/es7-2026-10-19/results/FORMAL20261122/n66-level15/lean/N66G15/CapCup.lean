/-!
# N66G15.CapCup: G3 — a 5-cap and a 5-cup with common endpoints form a convex octagon

Generated by `tools/gen_capcup.py`. From the two 5-paths (`sepath5`) and the packet condition (`chain5`) every
triple of each chain has its sign; the 8 points in the cyclic order `p, b1, b2, b3, q, a3, a2, a1` have every triple
positively oriented: chain triples directly, mixed triples by the affine identity of `mixed_pos`/`mixed_neg`
(`(Q−P)·o(X,Y,A) = (Q−A)·o(X,Y,P) + (A−P)·o(X,Y,Q) + (Y−X)·o(P,Q,A)` in x-coordinates); then
`hasConvexNGon_of_positive_cycle` gives a convex octagon.
-/

namespace N66G15
open ErdosSzekeres ErdosSzekeres.Omission N66E15

theorem mixed_pos (P Q X Y A : Point) (hPQ : P 0 < Q 0) (hXY : X 0 < Y 0) (hPA : P 0 < A 0) (hAQ : A 0 < Q 0)
    (hP : 0 ≤ orient X Y P) (hQ : 0 ≤ orient X Y Q) (hA : 0 < orient P Q A) : 0 < orient X Y A := by
  have key : (Q 0 - P 0) * orient X Y A =
      (Q 0 - A 0) * orient X Y P + (A 0 - P 0) * orient X Y Q + (Y 0 - X 0) * orient P Q A := by
    unfold orient; ring
  have h1 := mul_nonneg (sub_nonneg.2 hAQ.le) hP
  have h2 := mul_nonneg (sub_nonneg.2 hPA.le) hQ
  have h3 := mul_pos (sub_pos.2 hXY) hA
  have hq : 0 < Q 0 - P 0 := sub_pos.2 hPQ
  by_contra hn
  have hn' : orient X Y A ≤ 0 := le_of_not_gt hn
  nlinarith

theorem mixed_neg (P Q X Y A : Point) (hPQ : P 0 < Q 0) (hXY : X 0 < Y 0) (hPA : P 0 < A 0) (hAQ : A 0 < Q 0)
    (hP : orient X Y P ≤ 0) (hQ : orient X Y Q ≤ 0) (hA : orient P Q A < 0) : orient X Y A < 0 := by
  have key : (Q 0 - P 0) * orient X Y A =
      (Q 0 - A 0) * orient X Y P + (A 0 - P 0) * orient X Y Q + (Y 0 - X 0) * orient P Q A := by
    unfold orient; ring
  have h1 := mul_nonpos_iff.2 (Or.inl ⟨sub_nonneg.2 hAQ.le, hP⟩)
  have h2 := mul_nonpos_iff.2 (Or.inl ⟨sub_nonneg.2 hPA.le, hQ⟩)
  have h3 := mul_neg_of_pos_of_neg (sub_pos.2 hXY) hA
  have hq : 0 < Q 0 - P 0 := sub_pos.2 hPQ
  by_contra hn
  have hn' : 0 ≤ orient X Y A := le_of_not_gt hn
  nlinarith

theorem sepath5 {cup : ℕ → ℕ → ℕ → Bool} {color : Bool} {p u q : ℕ} (h : SEPath cup color p u q 5) :
    ∃ x1 x2, p < x1 ∧ x1 < x2 ∧ x2 < u ∧ u < q ∧ cup p x1 x2 = color ∧ cup x1 x2 u = color ∧
      cup x2 u q = color := by
  rcases h with _ | ⟨h4, huq, c4⟩
  rcases h4 with _ | ⟨h3, htu, c3⟩
  rcases h3 with _ | ⟨h2, hst, c2⟩
  rcases h2 with ⟨hps⟩ | ⟨h1, _, _⟩
  · exact ⟨_, _, hps, hst, htu, huq, c2, c3, c4⟩
  · rcases h1 with _ | ⟨h0, _, _⟩
    rcases h0

theorem pv_fill {x y z w col : Bool} (h : PacketValid x y z w) (hx : x = col) (hw : w = col) : y = col ∧ z = col := by
  obtain ⟨_, h2, _⟩ := h
  obtain ⟨e1, e2⟩ := h2 (hx.trans hw.symm)
  exact ⟨e1.symm.trans hx, e2.symm.trans hx⟩

/-- All ten triples of a 5-chain have the color of its consecutive triples (packet condition). -/
theorem chain5 {n : ℕ} (c : Configuration n) {col : Bool} {x0 x1 x2 x3 x4 : ℕ} (h01 : x0 < x1) (h12 : x1 < x2)
    (h23 : x2 < x3) (h34 : x3 < x4) (h4 : x4 < n) (c012 : c.cup x0 x1 x2 = col) (c123 : c.cup x1 x2 x3 = col)
    (c234 : c.cup x2 x3 x4 = col) :
    c.cup x0 x1 x3 = col ∧ c.cup x0 x2 x3 = col ∧ c.cup x1 x2 x4 = col ∧ c.cup x1 x3 x4 = col ∧
      c.cup x0 x1 x4 = col ∧ c.cup x0 x3 x4 = col ∧ c.cup x0 x2 x4 = col := by
  have sg := signotope_of_config c
  obtain ⟨c013, c023⟩ := pv_fill (sg x0 x1 x2 x3 h01 h12 h23 (by omega)) c012 c123
  obtain ⟨c124, c134⟩ := pv_fill (sg x1 x2 x3 x4 h12 h23 h34 h4) c123 c234
  obtain ⟨c014, c034⟩ := pv_fill (sg x0 x1 x3 x4 h01 (by omega) h34 h4) c013 c134
  obtain ⟨c024, -⟩ := pv_fill (sg x0 x2 x3 x4 (by omega) h23 h34 h4) c023 c234
  exact ⟨c013, c023, c124, c134, c014, c034, c024⟩

/-- The point of index `i` (0 outside the range). -/
noncomputable def ptOf {n : ℕ} (c : Configuration n) (i : ℕ) : Point :=
  if h : i < n then c.point ⟨i, h⟩ else 0

theorem ptOf_eq {n : ℕ} (c : Configuration n) {i : ℕ} (h : i < n) : ptOf c i = c.point ⟨i, h⟩ := by
  simp [ptOf, h]

theorem ptOf_pos {n : ℕ} (c : Configuration n) {i j k : ℕ} (hij : i < j) (hjk : j < k) (hk : k < n)
    (h : c.cup i j k = true) : 0 < orient (ptOf c i) (ptOf c j) (ptOf c k) := by
  rw [ptOf_eq c (by omega), ptOf_eq c (by omega), ptOf_eq c hk]
  exact (Configuration.cup_true_iff c ⟨i, by omega⟩ ⟨j, by omega⟩ ⟨k, hk⟩).1 h

theorem ptOf_neg {n : ℕ} (c : Configuration n) {i j k : ℕ} (hij : i < j) (hjk : j < k) (hk : k < n)
    (h : c.cup i j k = false) : orient (ptOf c i) (ptOf c j) (ptOf c k) < 0 := by
  rw [ptOf_eq c (by omega), ptOf_eq c (by omega), ptOf_eq c hk]
  exact (Configuration.cup_false_iff c ⟨i, by omega⟩ ⟨j, by omega⟩ ⟨k, hk⟩ hij hjk).1 h

theorem ptOf_x {n : ℕ} (c : Configuration n) {i j : ℕ} (hij : i < j) (hj : j < n) :
    ptOf c i 0 < ptOf c j 0 := by
  rw [ptOf_eq c (by omega), ptOf_eq c hj]
  exact c.xOrder (show (⟨i, by omega⟩ : Fin n) < ⟨j, hj⟩ from hij)

