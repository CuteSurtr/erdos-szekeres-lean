def ConvexIndependent.{u_1, u_2, u_3} : (𝕜 : Type u_1) →
  {E : Type u_2} →
    {ι : Type u_3} →
      [inst : Semiring 𝕜] → [PartialOrder 𝕜] → [inst_2 : AddCommGroup E] → [Module 𝕜 E] → (ι → E) → Prop :=
fun 𝕜 {E} {ι} [Semiring 𝕜] [PartialOrder 𝕜] [AddCommGroup E] [Module 𝕜 E] p =>
  ∀ (s : Set ι) (x : ι), p x ∈ (convexHull 𝕜) (p '' s) → x ∈ s
def Collinear.{u_1, u_2, u_3} : (k : Type u_1) →
  {V : Type u_2} →
    {P : Type u_3} →
      [inst : DivisionRing k] → [inst_1 : AddCommGroup V] → [Module k V] → [AddTorsor V P] → Set P → Prop :=
fun k {V} {P} [DivisionRing k] [AddCommGroup V] [Module k V] [AddTorsor V P] s => Module.rank k ↥(vectorSpan k s) ≤ 1
