@[reducible] def ErdosSzekeres.Point : Type :=
Fin 2 → ℝ
def ErdosSzekeres.GeneralPosition : Finset ErdosSzekeres.Point → Prop :=
fun s => ∀ a ∈ s, ∀ b ∈ s, ∀ c ∈ s, a ≠ b → a ≠ c → b ≠ c → ¬Collinear ℝ {a, b, c}
def ErdosSzekeres.ConvexPosition : Finset ErdosSzekeres.Point → Prop :=
fun s => ConvexIndependent ℝ fun p => ↑p
def ErdosSzekeres.HasConvexNGon : ℕ → Finset ErdosSzekeres.Point → Prop :=
fun n s => ∃ t ⊆ s, t.card = n ∧ ErdosSzekeres.ConvexPosition t
def ErdosSzekeres.LayerLemma.Invariant : (ErdosSzekeres.Point → ErdosSzekeres.Point) →
  Finset ErdosSzekeres.Point → Prop :=
fun f S => ∀ p ∈ S, f p ∈ S
def ErdosSzekeres.LayerLemma.rotAbout : ErdosSzekeres.Point → ℝ → ErdosSzekeres.Point → ErdosSzekeres.Point :=
fun c θ p =>
  ![c 0 + Real.cos θ * (p 0 - c 0) - Real.sin θ * (p 1 - c 1),
    c 1 + Real.sin θ * (p 0 - c 0) + Real.cos θ * (p 1 - c 1)]
def ErdosSzekeres.LayerLemma.Sevenfold70 : Prop :=
∀ (T : Finset ErdosSzekeres.Point) (c : ErdosSzekeres.Point),
  ErdosSzekeres.GeneralPosition T →
    c ∉ T →
      ErdosSzekeres.LayerLemma.Invariant (ErdosSzekeres.LayerLemma.rotAbout c (2 * Real.pi / 7)) T →
        T.card = 70 → ErdosSzekeres.HasConvexNGon 8 T
