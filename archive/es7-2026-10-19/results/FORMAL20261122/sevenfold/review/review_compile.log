def EncB.DimacsSat : List (List ℤ) → (ℕ → Bool) → Prop :=
fun cls ν => ∀ c ∈ cls, ∃ l ∈ c, 0 < l ∧ ν l.natAbs = true ∨ l < 0 ∧ ν l.natAbs = false
def EncB.DimacsSatisfiable : List (List ℤ) → Prop :=
fun cls => ∃ ν, EncB.DimacsSat cls ν
def EncB.cnfText : EncB.Enc → List ℤ → String :=
fun e cube => EncB.renderCube e.nv e.clauses (EncB.bodyR e.clauses) cube
def EncB.renderCube : ℕ → List (List ℤ) → String → List ℤ → String :=
fun nv F bodyF cube => EncB.headerR nv (EncB.cubeCnf F cube).length ++ EncB.cubeBodyR bodyF cube
def EncB.encode : ℕ → ℕ → ℕ → EncB.Enc :=
fun m K t =>
  have cls := EncB.genCoded m K t;
  have codes := EncB.allCodesOf m K t cls;
  have nm := EncB.numberMap codes;
  { clauses := List.map (fun cl => List.map (EncB.renumberLit nm) cl) cls, nv := codes.length, codes := codes,
    nmap := nm }
def EncB.encB : ℕ → ℕ → ℕ → List (List ℤ) :=
fun m K t => (EncB.encode m K t).clauses
def EncB.numVars : ℕ → ℕ → ℕ → ℕ :=
fun m K t => (EncB.encode m K t).nv
def EncB.cubeCnf : List (List ℤ) → List ℤ → List (List ℤ) :=
fun F cube => F ++ List.map (fun z => [z]) cube
def EncB.parseDimacs : String → Option (ℕ × List (List ℤ)) :=
fun s => EncB.parseDimacsChars s.data
