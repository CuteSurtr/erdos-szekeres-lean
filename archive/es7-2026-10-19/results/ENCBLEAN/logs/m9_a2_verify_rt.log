parseDimacs_render : ∀ (nv : Nat) (F : List (List Int)),
  (∀ (cl : List Int), cl ∈ F → ∀ (l : Int), l ∈ cl → l ≠ 0 ∧ l.natAbs ≤ nv) → parseDimacs (render nv F) = some (nv, F)
renderCube_eq : ∀ (nv : Nat) (F : List (List Int)) (cube : List Int),
  renderCube nv F (bodyR F) cube = render nv (cubeCnf F cube)
parseDimacs_renderCube : ∀ (nv : Nat) (F : List (List Int)) (cube : List Int),
  (∀ (cl : List Int), cl ∈ F → ∀ (l : Int), l ∈ cl → l ≠ 0 ∧ l.natAbs ≤ nv) →
    (∀ (z : Int), z ∈ cube → z ≠ 0 ∧ z.natAbs ≤ nv) →
      parseDimacs (renderCube nv F (bodyR F) cube) = some (nv, cubeCnf F cube)
cnfText_encode : ∀ (m K t : Nat) (cube : List Int),
  cnfText (encode m K t) cube = renderCube (numVars m K t) (encB m K t) (bodyR (encB m K t)) cube
parseDimacs_cnfText : ∀ (m K t : Nat) (cube : List Int),
  (∀ (z : Int), z ∈ cube → z ≠ 0 ∧ z.natAbs ≤ numVars m K t) →
    parseDimacs (cnfText (encode m K t) cube) = some (numVars m K t, cubeCnf (encB m K t) cube)
numVars_ge_45 : ∀ (m K : Nat), 45 ≤ numVars m K 11
@parseDimacs_cube64 : ∀ {c : List Int},
  c ∈ cubes64 →
    parseDimacs (renderCube (numVars 6 8 11) (encB 6 8 11) (bodyR (encB 6 8 11)) c) =
      some (numVars 6 8 11, cubeCnf (encB 6 8 11) c)
parseDimacs_cube64_get : ∀ (i : Nat) (h : i < cubes64.length),
  parseDimacs (cnfText (encode 6 8 11) (cubes64.get ⟨i, h⟩)) =
    some (numVars 6 8 11, cubeCnf (encB 6 8 11) (cubes64.get ⟨i, h⟩))
parseDimacs_base6811 : parseDimacs (renderCube (numVars 6 8 11) (encB 6 8 11) (bodyR (encB 6 8 11)) []) =
  some (numVars 6 8 11, encB 6 8 11)
cubesUnsat64_of_texts : (∀ (c : List Int),
    c ∈ cubes64 →
      ∀ (nv : Nat) (G : List (List Int)),
        parseDimacs (renderCube (numVars 6 8 11) (encB 6 8 11) (bodyR (encB 6 8 11)) c) = some (nv, G) →
          ¬DimacsSatisfiable G) →
  CubesUnsat64
encB_unsat_of_texts : (∀ (c : List Int),
    c ∈ cubes64 →
      ∀ (nv : Nat) (G : List (List Int)),
        parseDimacs (renderCube (numVars 6 8 11) (encB 6 8 11) (bodyR (encB 6 8 11)) c) = some (nv, G) →
          ¬DimacsSatisfiable G) →
  ¬DimacsSatisfiable (encB 6 8 11)
render_ascii : ∀ (nv : Nat) (F : List (List Int)) (c : Char), c ∈ (render nv F).data → c.toNat < 128
cnfText_bytes : ∀ (e : Enc) (cube : List Int),
  (cnfText e cube).toUTF8.data.toList = List.map (fun c => c.val.toUInt8) (cnfText e cube).data
natDigits_eq_toDigits : ∀ (n : Nat), natDigits n = Nat.toDigits 10 n
pushNat_eq_append_toString : ∀ (s : String) (n : Nat), pushNat s n = s ++ toString n
def EncB.CubesUnsat64 : Prop :=
∀ (c : List Int), c ∈ cubes64 → ¬DimacsSatisfiable (cubeCnf (encB 6 8 11) c)
def EncB.DimacsSatisfiable : List (List Int) → Prop :=
fun cls => ∃ ν, DimacsSat cls ν
def EncB.DimacsSat : List (List Int) → (Nat → Bool) → Prop :=
fun cls ν => ∀ (c : List Int), c ∈ cls → ∃ l, l ∈ c ∧ (0 < l ∧ ν l.natAbs = true ∨ l < 0 ∧ ν l.natAbs = false)
def EncB.cubeCnf : List (List Int) → List Int → List (List Int) :=
fun F cube => F ++ List.map (fun z => [z]) cube
def EncB.render : Nat → List (List Int) → String :=
fun nv F => headerR nv F.length ++ bodyR F
def EncB.renderCube : Nat → List (List Int) → String → List Int → String :=
fun nv F bodyF cube => headerR nv (cubeCnf F cube).length ++ cubeBodyR bodyF cube
def EncB.cnfText : Enc → List Int → String :=
fun e cube => renderCube e.nv e.clauses (bodyR e.clauses) cube
def EncB.parseDimacs : String → Option (Nat × List (List Int)) :=
fun s => parseDimacsChars s.data
