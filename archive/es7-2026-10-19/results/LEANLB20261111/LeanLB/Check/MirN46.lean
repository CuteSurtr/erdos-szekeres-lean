import LeanLB.Geometry
import LeanLB.Data.MirN46

/-! Kernel evaluations for `mirN46` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks.py` (budget 40000); the anchor loop is split into 6 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 46 points. -/
theorem mirN46_len : mirN46Nat.length = 46 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem mirN46_gp : gpOK mirN46Nat = true := by decide +kernel

theorem mirN46_dp_0 : checkFrom 6 mirN46Nat 0 3 = true := by decide +kernel
theorem mirN46_dp_1 : checkFrom 6 mirN46Nat 3 11 = true := by decide +kernel
theorem mirN46_dp_2 : checkFrom 6 mirN46Nat 11 24 = true := by decide +kernel
theorem mirN46_dp_3 : checkFrom 6 mirN46Nat 24 29 = true := by decide +kernel
theorem mirN46_dp_4 : checkFrom 6 mirN46Nat 29 45 = true := by decide +kernel
theorem mirN46_dp_5 : checkFrom 6 mirN46Nat 45 46 = true := by decide +kernel

/-- No anchor starts a chain of 7 left turns: no 8 points in convex position. -/
theorem mirN46_dp : checkAll 6 mirN46Nat = true := by
  apply checkAll_of_checkFrom
  rw [mirN46_len]
  exact (checkFrom_trans (by decide : 0 ≤ 45) (by decide : 45 ≤ 46)
      (checkFrom_trans (by decide : 0 ≤ 29) (by decide : 29 ≤ 45)
      (checkFrom_trans (by decide : 0 ≤ 24) (by decide : 24 ≤ 29)
      (checkFrom_trans (by decide : 0 ≤ 11) (by decide : 11 ≤ 24)
      (checkFrom_trans (by decide : 0 ≤ 3) (by decide : 3 ≤ 11)
      mirN46_dp_0 mirN46_dp_1) mirN46_dp_2) mirN46_dp_3) mirN46_dp_4) mirN46_dp_5)

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem mirN46_link : mirN46Rows.map latXY = mirN46Nat.map (unshift mirN46Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem mirN46_closed : ∀ w ∈ mirN46Rows, reflXY w ∈ mirN46Rows := by decide +kernel

end LeanLB
