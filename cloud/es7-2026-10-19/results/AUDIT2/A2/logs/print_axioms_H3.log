def Mir.yflipUnit : ℕ → ℕ → ℕ → List (List ℤ) :=
fun N A U => [[↑((num N A U).getD (subVar N false (ETV.Var.x 0 1 2)) 0)]]
def Mir.interiorCnf : ℕ → ℕ → List (List ℤ) :=
fun N K => mirgen (subDimacs N K K K false) ++ interiorClauses N K K ++ yflipUnit N K K
