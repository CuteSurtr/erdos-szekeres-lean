---- regress_modes.sh (sha256 089e4a16d7e385c887029e631a0048a2536ca48c674fc450411cd96ce5f65f6f)
#!/usr/bin/env bash
# regress_modes.sh OLD NEW WORK: run every encb_dimacs mode with the old exe and the new exe on small instances and
# compare stdout bytes, stderr bytes, exit codes and written files. Expected differences: only the usage text on
# error paths (stderr) and the timings printed by twin-profile (all digits masked) and twin-check (`_ms=` masked). Then check the new mode twin-cube64 against the OLD
# exe's twin-cubes64 and twin-cube on (3,4,11) for all 64 indices, and its error paths.
set -u -o pipefail
OLD=$1; NEW=$2; W=$3
mkdir -p "$W"; rm -rf "$W"/o "$W"/n; mkdir -p "$W"/o "$W"/n
fail=0; same=0; diffc=0
run() {  # tag args...: run both, compare
  local tag=$1; shift
  "$OLD" "$@" >"$W/o/out" 2>"$W/o/err"; local ro=$?
  "$NEW" "$@" >"$W/n/out" 2>"$W/n/err"; local rn=$?
  if [ "$tag" = profile ]; then sed -i -E 's/[0-9]+/#/g' "$W/o/out" "$W/n/out"; fi
  if [ "$tag" = check ]; then sed -i -E 's/_ms=[0-9]+/_ms=#/g' "$W/o/out" "$W/n/out"; fi
  local so se
  cmp -s "$W/o/out" "$W/n/out" && so=same || so=DIFF
  cmp -s "$W/o/err" "$W/n/err" && se=same || se=DIFF
  local line="[$tag] $* : rc old=$ro new=$rn stdout $so ($(wc -c <"$W/n/out") B, sha $(sha256sum <"$W/n/out" | cut -c1-12)) stderr $se"
  if [ $ro -ne $rn ] || [ $so != same ] || { [ $se != same ] && [ "$tag" != usage ]; }; then
    echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1))
  else
    echo "ok $line"; same=$((same+1))
  fi
  if [ "$tag" = usage ] && [ $se != same ]; then diff "$W/o/err" "$W/n/err" | sed 's/^/    usage diff: /'; fi
}
for mkt in "3 4 1" "3 4 2" "6 4 1" "4 5 1" "6 8 3" "7 8 2" "7 8 3" "8 8 2" "6 8 0" "3 3 3" "2 4 3" "2 5 4" "1 4 2" "3 4 11"; do
  for mode in base stats twin-base twin-stats twin-ymap; do run plain $mode $mkt; done
  run check twin-check $mkt
  run plain cube $mkt 1 -2 3
  run plain twin-cube $mkt 1 -2 3
  run plain twin-cube $mkt
  run profile twin-profile $mkt
done
# files mode (gen) into two directories
for mkt in "6 8 5" "3 4 11" "2 4 3"; do
  rm -rf "$W/fo" "$W/fn"; mkdir -p "$W/fo" "$W/fn"
  "$OLD" files $mkt "$W/fo" base full_Y12 c10101 n00011 >"$W/o/out" 2>"$W/o/err"; ro=$?
  "$NEW" files $mkt "$W/fn" base full_Y12 c10101 n00011 >"$W/n/out" 2>"$W/n/err"; rn=$?
  sed -i "s#$W/fo#DIR#g" "$W/o/err"; sed -i "s#$W/fn#DIR#g" "$W/n/err"
  d=$(diff -r "$W/fo" "$W/fn" >/dev/null && echo same || echo DIFF); e=$(cmp -s "$W/o/err" "$W/n/err" && echo same || echo DIFF)
  line="[files] $mkt base full_Y12 c10101 n00011 : rc old=$ro new=$rn files $d ($(ls "$W/fn" | wc -l) files) stderr $e"
  if [ $ro -ne $rn ] || [ $d != same ] || [ $e != same ]; then echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1)); else echo "ok $line"; same=$((same+1)); fi
done
# twin-cubes64: all 64 + base on (3,4,11); a named subset; refusal on (6,8,5) (cube variables are not the Y's)
for spec in "3 4 11|" "3 4 11|c11111 n00000 c01010" "6 8 5|" "6 8 5|c11111" "3 4 11|bogus"; do
  mkt=${spec%%|*}; names=${spec#*|}
  rm -rf "$W/fo" "$W/fn"; mkdir -p "$W/fo" "$W/fn"
  "$OLD" twin-cubes64 $mkt "$W/fo" $names >"$W/o/out" 2>"$W/o/err"; ro=$?
  "$NEW" twin-cubes64 $mkt "$W/fn" $names >"$W/n/out" 2>"$W/n/err"; rn=$?
  sed -i "s#$W/fo#DIR#g" "$W/o/err"; sed -i "s#$W/fn#DIR#g" "$W/n/err"
  d=$(diff -r "$W/fo" "$W/fn" >/dev/null && echo same || echo DIFF); e=$(cmp -s "$W/o/err" "$W/n/err" && echo same || echo DIFF)
  line="[twin-cubes64] $mkt ${names:-<all>} : rc old=$ro new=$rn files $d ($(ls "$W/fn" | wc -l) files, $(cat "$W"/fn/*.cnf 2>/dev/null | sha256sum | cut -c1-12)) stdout $(cmp -s "$W/o/out" "$W/n/out" && echo same || echo DIFF) stderr $e"
  if [ $ro -ne $rn ] || [ $d != same ] || [ $e != same ]; then echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1)); else echo "ok $line"; same=$((same+1)); fi
done
# error paths (usage text changed on purpose: one line added for twin-cube64)
run usage
run usage nosuchmode 1 2 3
run usage base x 8 3
run usage twin-base 6 8
run usage twin-cubes64 6 8 11
run usage files 6 8 3
# the new mode against the OLD exe: twin-cube64 3 4 11 I = old twin-cubes64 file of the same name = old twin-cube
rm -rf "$W/fo"; mkdir -p "$W/fo"; "$OLD" twin-cubes64 3 4 11 "$W/fo" 2>"$W/o/err" >/dev/null || { echo "UNEXPECTED old twin-cubes64 failed"; fail=1; }
names=(); ok64=0
for I in $(seq 0 63); do
  "$NEW" twin-cube64 3 4 11 "$I" >"$W/n/out" 2>"$W/n/err"; rn=$?
  nm=$(sed -n 's/^cubes64\[[0-9]*\] name \([cn][01]*\) units .*/\1/p' "$W/n/err")
  units=$(sed -n 's/^cubes64\[[0-9]*\] name [cn][01]* units \[\(.*\)\]$/\1/p' "$W/n/err" | tr -d ',')
  "$OLD" twin-cube 3 4 11 $units >"$W/o/out" 2>/dev/null; ro=$?
  if [ $rn -eq 0 ] && [ $ro -eq 0 ] && [ -n "$nm" ] && cmp -s "$W/n/out" "$W/fo/$nm.cnf" && cmp -s "$W/n/out" "$W/o/out"; then
    ok64=$((ok64+1)); names+=("$nm")
  else
    echo "UNEXPECTED twin-cube64 3 4 11 $I: rc $rn name '$nm' units '$units'"; fail=1
  fi
done
nd=$(printf '%s\n' "${names[@]}" | sort -u | wc -l)
echo "twin-cube64 3 4 11 I, I = 0..63: $ok64/64 equal to the OLD exe's twin-cubes64 file of the same name and to OLD twin-cube with the same units; $nd distinct names; first ${names[0]} last ${names[63]}"
[ $ok64 -eq 64 ] && [ $nd -eq 64 ] || fail=1
# the new mode's base agrees with the old twin-base and the old twin-cubes64 base.cnf
"$OLD" twin-base 3 4 11 2>/dev/null | cmp -s - "$W/fo/base.cnf" && echo "old twin-base 3 4 11 = old twin-cubes64 base.cnf" || { echo "UNEXPECTED base"; fail=1; }
# error paths of the new mode
for a in "3 4 11 64" "3 4 11 -1" "3 4 11 x" "3 4 11" "3 4 11 0 1" "2 4 3 0"; do
  "$NEW" twin-cube64 $a >"$W/n/out" 2>"$W/n/err"; rn=$?
  echo "new twin-cube64 $a : rc=$rn stdout $(wc -c <"$W/n/out") B; stderr: $(head -c 160 "$W/n/err" | tr '\n' '|')"
done
rm -rf "$W/fo" "$W/fn" "$W/o" "$W/n"
echo "SUMMARY same=$same unexpected=$diffc"
[ $fail -eq 0 ] && echo "REGRESSION PASS" || echo "REGRESSION FAIL"
exit $fail
