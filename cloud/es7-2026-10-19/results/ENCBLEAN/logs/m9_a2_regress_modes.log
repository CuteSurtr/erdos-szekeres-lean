---- script regress_a2.sh (sha256 1ed551133b1840b3edb7841671efb9011b5fa585b04823ed5e2b60721424c676)
#!/usr/bin/env bash
# regress_a2.sh OLD NEW WORK: M9 task A2. Every encb_dimacs mode, old exe (A1, a0dff6f2..., core toString printer)
# against new exe (A2, Render.lean printer), byte for byte: stdout, stderr, exit codes, written files. Expected
# differences: twin-profile prints timings (digits masked) and its label `bodyL` became `bodyR` (mapped in the old
# output); twin-check prints `_ms=` timings (masked). Nothing else may differ. Then: twin-cube64 for all 64 indices
# on (3,4,11) and on (6,8,6), new against old; decimal printing on edge values (units through twin-cube and the
# gen-mode cube, which must stay core's printer).
set -u -o pipefail
OLD=$1; NEW=$2; W=$3
mkdir -p "$W"; rm -rf "$W"/o "$W"/n; mkdir -p "$W"/o "$W"/n
fail=0; same=0; diffc=0
run() {  # tag args...: run both, compare
  local tag=$1; shift
  "$OLD" "$@" >"$W/o/out" 2>"$W/o/err"; local ro=$?
  "$NEW" "$@" >"$W/n/out" 2>"$W/n/err"; local rn=$?
  if [ "$tag" = profile ]; then
    sed -i -E 's/[0-9]+/#/g' "$W/o/out" "$W/n/out" "$W/o/err" "$W/n/err"
    sed -i -E 's/bodyL/bodyR/g' "$W/o/out" "$W/o/err"
  fi
  if [ "$tag" = check ]; then sed -i -E 's/_ms=[0-9]+/_ms=#/g' "$W/o/out" "$W/n/out"; fi
  local so se
  cmp -s "$W/o/out" "$W/n/out" && so=same || so=DIFF
  cmp -s "$W/o/err" "$W/n/err" && se=same || se=DIFF
  local line="[$tag] $* : rc old=$ro new=$rn stdout $so ($(wc -c <"$W/n/out") B, sha $(sha256sum <"$W/n/out" | cut -c1-12)) stderr $se"
  if [ $ro -ne $rn ] || [ $so != same ] || [ $se != same ]; then
    echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1))
  else
    echo "ok $line"; same=$((same+1))
  fi
}
EDGE="0 -1 1 9 -9 10 -10 99 100 127 -127 128 -128 129 999 1000 65535 65536 78059 -78059 2147483647 2147483648 -2147483649 4294967295 4294967296 9223372036854775807 9223372036854775808 -9223372036854775808 -9223372036854775809 18446744073709551615 18446744073709551616 -18446744073709551616 123456789012345678901234567890 -123456789012345678901234567890"
for mkt in "3 4 1" "3 4 2" "6 4 1" "4 5 1" "6 8 3" "7 8 2" "7 8 3" "8 8 2" "6 8 0" "3 3 3" "2 4 3" "2 5 4" "1 4 2" "3 4 11" "6 8 5" "6 8 6" "7 8 5"; do
  for mode in base stats twin-base twin-stats twin-ymap; do run plain $mode $mkt; done
  run check twin-check $mkt
  run plain cube $mkt 1 -2 3
  run plain twin-cube $mkt 1 -2 3
  run plain twin-cube $mkt
  run profile twin-profile $mkt
done
# decimal printing on edge values: the twin printer (new: Render.pushInt) and the gen printer (core toString, unchanged)
run plain twin-cube 3 4 1 $EDGE
run plain cube 3 4 1 $EDGE
run plain twin-cube 6 8 5 $EDGE
# files mode (gen) into two directories
for mkt in "6 8 5" "3 4 11" "2 4 3"; do
  rm -rf "$W/fo" "$W/fn"; mkdir -p "$W/fo" "$W/fn"
  "$OLD" files $mkt "$W/fo" base full_Y12 c10101 n00011 >"$W/o/out" 2>"$W/o/err"; ro=$?
  "$NEW" files $mkt "$W/fn" base full_Y12 c10101 n00011 >"$W/n/out" 2>"$W/n/err"; rn=$?
  sed -i "s#$W/fo#DIR#g" "$W/o/err"; sed -i "s#$W/fn#DIR#g" "$W/n/err"
  d=$(diff -r "$W/fo" "$W/fn" >/dev/null && echo same || echo DIFF); e=$(cmp -s "$W/o/err" "$W/n/err" && echo same || echo DIFF)
  line="[files] $mkt base full_Y12 c10101 n00011 : rc old=$ro new=$rn files $d ($(ls "$W/fn" | wc -l) files) stderr $e"
  if [ $ro -ne $rn ] || [ $d != same ] || [ $e != same ]; then echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1)); else echo "ok $line"; same=$((same+1)); fi
done
# twin-cubes64: all 64 + base on (3,4,11); a named subset; refusal on (6,8,5) (cube variables are not the Y's)
for spec in "3 4 11|" "3 4 11|c11111 n00000 c01010" "6 8 5|" "6 8 5|c11111" "3 4 11|bogus"; do
  mkt=${spec%%|*}; names=${spec#*|}
  rm -rf "$W/fo" "$W/fn"; mkdir -p "$W/fo" "$W/fn"
  "$OLD" twin-cubes64 $mkt "$W/fo" $names >"$W/o/out" 2>"$W/o/err"; ro=$?
  "$NEW" twin-cubes64 $mkt "$W/fn" $names >"$W/n/out" 2>"$W/n/err"; rn=$?
  sed -i "s#$W/fo#DIR#g" "$W/o/err"; sed -i "s#$W/fn#DIR#g" "$W/n/err"
  d=$(diff -r "$W/fo" "$W/fn" >/dev/null && echo same || echo DIFF); e=$(cmp -s "$W/o/err" "$W/n/err" && echo same || echo DIFF)
  line="[twin-cubes64] $mkt ${names:-<all>} : rc old=$ro new=$rn files $d ($(ls "$W/fn" | wc -l) files, $(cat "$W"/fn/*.cnf 2>/dev/null | sha256sum | cut -c1-12)) stdout $(cmp -s "$W/o/out" "$W/n/out" && echo same || echo DIFF) stderr $e"
  if [ $ro -ne $rn ] || [ $d != same ] || [ $e != same ]; then echo "UNEXPECTED $line"; fail=1; diffc=$((diffc+1)); else echo "ok $line"; same=$((same+1)); fi
done
# error paths (usage text unchanged in A2)
run usage
run usage nosuchmode 1 2 3
run usage base x 8 3
run usage twin-base 6 8
run usage twin-cubes64 6 8 11
run usage files 6 8 3
for a in "3 4 11 64" "3 4 11 -1" "3 4 11 x" "3 4 11" "3 4 11 0 1" "2 4 3 0"; do run usage twin-cube64 $a; done
# twin-cube64, all 64 indices, new against old, on (3,4,11) and (6,8,6)
for mkt in "3 4 11" "6 8 6"; do
  ok64=0
  for I in $(seq 0 63); do
    "$OLD" twin-cube64 $mkt "$I" >"$W/o/out" 2>"$W/o/err"; ro=$?
    "$NEW" twin-cube64 $mkt "$I" >"$W/n/out" 2>"$W/n/err"; rn=$?
    if [ $ro -eq $rn ] && cmp -s "$W/o/out" "$W/n/out" && cmp -s "$W/o/err" "$W/n/err"; then ok64=$((ok64+1)); else
      echo "UNEXPECTED twin-cube64 $mkt $I: rc old=$ro new=$rn"; fail=1; diffc=$((diffc+1)); fi
  done
  echo "twin-cube64 $mkt I, I = 0..63: $ok64/64 identical (stdout, stderr, exit code) to the old exe; last stdout $(wc -c <"$W/n/out") B"
  same=$((same+ok64))
done
rm -rf "$W/fo" "$W/fn" "$W/o" "$W/n"
echo "SUMMARY same=$same unexpected=$diffc"
[ $fail -eq 0 ] && echo "REGRESSION PASS" || echo "REGRESSION FAIL"
exit $fail
