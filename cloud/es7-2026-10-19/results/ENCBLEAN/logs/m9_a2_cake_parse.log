---- script cake_parse.sh (sha256 9600ff0c52d8e9935c2966efd5e6caa531200fad6137a2404ecf6759d4c81a39)
#!/usr/bin/env bash
# cake_parse.sh EXE CAKE WORK: M9 task A2, evidence for E3 (not a proof). cake_lpr with one argument parses the
# DIMACS file and prints the parsed formula. (1) For texts the twin prints (new exe), cake_lpr's printout must be
# byte-identical to the text: cake_lpr then read exactly the clause list in the file. (2) The texts that
# Render.lean's kernel-checked examples feed to parseDimacs, given to cake_lpr: what does it do with them?
set -u -o pipefail
EXE=$1; CAKE=$2; W=$3
mkdir -p "$W"; fail=0; n=0
echo "exe $(sha256sum "$EXE" | cut -c1-64); cake_lpr $(sha256sum "$CAKE" | cut -c1-64)"
chk() {  # label args...: emit with the exe, parse-print with cake_lpr, compare
  local label=$1; shift
  "$EXE" "$@" > "$W/f.cnf" 2>/dev/null || { echo "FAIL $label: exe rc $?"; fail=1; return; }
  "$CAKE" "$W/f.cnf" > "$W/p.out" 2> "$W/p.err"; local rc=$?
  if cmp -s "$W/f.cnf" "$W/p.out"; then r=identical; n=$((n+1)); else r=DIFFERENT; fail=1; fi
  echo "$label: $(head -1 "$W/f.cnf"), $(wc -c < "$W/f.cnf") B, sha $(sha256sum < "$W/f.cnf" | cut -c1-12); cake_lpr rc $rc, stderr $(wc -c < "$W/p.err") B; printout $r"
}
for mkt in "3 4 1" "3 4 2" "6 4 1" "4 5 1" "6 8 3" "7 8 3" "6 8 5" "6 8 6" "7 8 5"; do chk "twin-base $mkt" twin-base $mkt; done
for I in 0 1 31 32 33 63; do chk "twin-cube64 3 4 11 $I" twin-cube64 3 4 11 $I; chk "twin-cube64 6 8 6 $I" twin-cube64 6 8 6 $I; done
echo "(1) $n texts: cake_lpr's printout byte-identical to the text"
echo "(2) texts of Render.lean's examples (parseDimacs result in brackets):"
i=0
while IFS='|' read -r ours txt; do
  i=$((i+1)); printf '%b' "$txt" > "$W/r$i.cnf"
  "$CAKE" "$W/r$i.cnf" > "$W/p.out" 2> "$W/p.err"; rc=$?
  echo "  [$ours] \"$txt\" ($(wc -c < "$W/r$i.cnf") B): cake_lpr rc $rc, stdout $(sed 's/$/\\n/' "$W/p.out" | tr -d '\n' | head -c 80), stderr $(tr '\n' '|' < "$W/p.err" | head -c 100)"
done <<'TXT'
some (3, [[1,-2],[],[3]])|p cnf 3 3\n1 -2 0\n 0\n3 0\n
none: count|p cnf 3 2\n1 -2 0\n
none: inner 0|p cnf 3 1\n1 0 2 0\n
none: var > nv|p cnf 3 1\n-4 0\n
none: leading zero|p cnf 3 1\n01 0\n
none: leading zero (header)|p cnf 03 1\n1 0\n
none: -0|p cnf 3 1\n-0 0\n
none: two spaces|p cnf 3 1\n1  0\n
none: leading space|p cnf 3 1\n 1 0\n
none: no final newline|p cnf 3 1\n1 0
none: blank line|p cnf 3 1\n1 0\n\n
none: bare 0|p cnf 3 1\n0\n
none: comment line|c x\np cnf 3 1\n1 0\n
none: +1|p cnf 3 1\n+1 0\n
TXT
rm -f "$W"/f.cnf "$W"/p.out "$W"/p.err "$W"/r*.cnf
[ $fail -eq 0 ] && echo "CAKE PARSE PASS (part 1)" || echo "CAKE PARSE FAIL (part 1)"
exit $fail

