---- script cake_parse_6811.sh (sha256 59535176e97dfc43e6dd5d99bfef925022be87b1367d87e924e89143d90afa90)
#!/usr/bin/env bash
# cake_parse_6811.sh EXE CAKE WORK: M9 task A2, evidence for E3 on the real instance (not a proof). For the base and
# two cubes of (6,8,11): write the exe's text to WORK, check its sha256 against the record given on the command
# line of this script's caller (printed), then let cake_lpr parse it and print the parsed formula; the printout must be
# byte-identical to the text (cake_lpr prints `p cnf <largest variable> <clauses>`, so this also says that variable
# nv occurs). The text is deleted afterwards.
set -u -o pipefail
EXE=$1; CAKE=$2; W=$3
mkdir -p "$W"; fail=0
echo "exe $(sha256sum "$EXE" | cut -c1-64); cake_lpr $(sha256sum "$CAKE" | cut -c1-64)"
one() {  # label args...
  local label=$1; shift
  /usr/bin/time -f '%e s, %M KB' -o "$W/t1" "$EXE" "$@" > "$W/f.cnf" 2>/dev/null || { echo "FAIL $label: exe rc"; fail=1; return; }
  local fs; fs=$(sha256sum < "$W/f.cnf" | cut -c1-64)
  /usr/bin/time -f '%e s, %M KB' -o "$W/t2" "$CAKE" "$W/f.cnf" 2> "$W/p.err" | sha256sum > "$W/p.sha"
  local ps; ps=$(cut -c1-64 "$W/p.sha")
  if [ "$fs" = "$ps" ]; then r=identical; else r=DIFFERENT; fail=1; fi
  echo "$label: $(head -1 "$W/f.cnf"), $(wc -c < "$W/f.cnf") B, sha256 $fs (exe $(cat "$W/t1")); cake_lpr printout sha256 $ps (cake_lpr $(cat "$W/t2"), stderr $(wc -c < "$W/p.err") B): $r"
  rm -f "$W/f.cnf"
}
one "twin-base 6 8 11" twin-base 6 8 11
one "twin-cube64 6 8 11 0" twin-cube64 6 8 11 0
one "twin-cube64 6 8 11 63" twin-cube64 6 8 11 63
rm -f "$W/t1" "$W/t2" "$W/p.err" "$W/p.sha"
[ $fail -eq 0 ] && echo "CAKE PARSE 6811 PASS" || echo "CAKE PARSE 6811 FAIL"
exit $fail
