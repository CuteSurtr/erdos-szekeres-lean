import LeanLB.Geometry
import LeanLB.Data.C4N52

/-! Kernel evaluations for `c4N52` (`decide +kernel`; no `native_decide`). Generated by
`scripts/gen_checks.py` (budget 40000); the anchor loop is split into 10 ranges. -/

namespace LeanLB

set_option maxRecDepth 100000

/-- 52 points. -/
theorem c4N52_len : c4N52Nat.length = 52 := by decide +kernel

/-- Distinct points, no three collinear (lattice coordinates). -/
theorem c4N52_gp : gpOK c4N52Nat = true := by decide +kernel

theorem c4N52_dp_0 : checkFrom 6 c4N52Nat 0 3 = true := by decide +kernel
theorem c4N52_dp_1 : checkFrom 6 c4N52Nat 3 4 = true := by decide +kernel
theorem c4N52_dp_2 : checkFrom 6 c4N52Nat 4 5 = true := by decide +kernel
theorem c4N52_dp_3 : checkFrom 6 c4N52Nat 5 11 = true := by decide +kernel
theorem c4N52_dp_4 : checkFrom 6 c4N52Nat 11 15 = true := by decide +kernel
theorem c4N52_dp_5 : checkFrom 6 c4N52Nat 15 19 = true := by decide +kernel
theorem c4N52_dp_6 : checkFrom 6 c4N52Nat 19 24 = true := by decide +kernel
theorem c4N52_dp_7 : checkFrom 6 c4N52Nat 24 34 = true := by decide +kernel
theorem c4N52_dp_8 : checkFrom 6 c4N52Nat 34 42 = true := by decide +kernel
theorem c4N52_dp_9 : checkFrom 6 c4N52Nat 42 52 = true := by decide +kernel

/-- No anchor starts a chain of 7 left turns: no 8 points in convex position. -/
theorem c4N52_dp : checkAll 6 c4N52Nat = true := by
  apply checkAll_of_checkFrom
  rw [c4N52_len]
  exact (checkFrom_trans (by decide : 0 ≤ 42) (by decide : 42 ≤ 52)
      (checkFrom_trans (by decide : 0 ≤ 34) (by decide : 34 ≤ 42)
      (checkFrom_trans (by decide : 0 ≤ 24) (by decide : 24 ≤ 34)
      (checkFrom_trans (by decide : 0 ≤ 19) (by decide : 19 ≤ 24)
      (checkFrom_trans (by decide : 0 ≤ 15) (by decide : 15 ≤ 19)
      (checkFrom_trans (by decide : 0 ≤ 11) (by decide : 11 ≤ 15)
      (checkFrom_trans (by decide : 0 ≤ 5) (by decide : 5 ≤ 11)
      (checkFrom_trans (by decide : 0 ≤ 4) (by decide : 4 ≤ 5)
      (checkFrom_trans (by decide : 0 ≤ 3) (by decide : 3 ≤ 4)
      c4N52_dp_0 c4N52_dp_1) c4N52_dp_2) c4N52_dp_3) c4N52_dp_4) c4N52_dp_5) c4N52_dp_6) c4N52_dp_7) c4N52_dp_8) c4N52_dp_9)

/-- The checker's coordinates are the lattice coordinates of the rows, translated. -/
theorem c4N52_link : c4N52Rows.map lat4 = c4N52Nat.map (unshift c4N52Shift) := by decide +kernel

/-- The rows are closed under the symmetry. -/
theorem c4N52_closed : ∀ w ∈ c4N52Rows, shift4 w ∈ c4N52Rows := by decide +kernel

end LeanLB
