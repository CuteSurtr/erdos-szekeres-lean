import V2L.Trees.Table
import V2L.Trees.N255_0

/-! The tree check of case U3_L4 from its 3 per-sibling-list kernel checks (generated by
`scripts/gen_trees.py`). -/

namespace V2L.Trees

open Mir

set_option maxRecDepth 100000 in
theorem sib255 : tree255.sibLists = [n255_0.map Prod.fst, n255_1.map Prod.fst, n255_2.map Prod.fst] := rfl

set_option maxRecDepth 100000 in
theorem check255 : (treeOf ([3], [4])).check = true := by
  have e : treeOf ([3], [4]) = tree255 := rfl
  have a3 : AllOf CoverOk ([] : List (List (List Int))) := AllOf.nil
  have a2 := AllOf.cons (P := CoverOk) (a := n255_2.map Prod.fst) c255_2 a3
  have a1 := AllOf.cons (P := CoverOk) (a := n255_1.map Prod.fst) c255_1 a2
  have a0 := AllOf.cons (P := CoverOk) (a := n255_0.map Prod.fst) c255_0 a1
  rw [e]
  exact CTree.check_of_sibLists (by rw [sib255]; exact a0.forall)

end V2L.Trees
