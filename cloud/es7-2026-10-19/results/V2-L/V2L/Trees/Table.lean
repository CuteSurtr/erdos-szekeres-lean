  (([16], [13]), .leaf),
  (([16], [14]), .leaf),
  (([16], [15]), .leaf)]

/-- The cube tree of a case (`.node []`, which fails `check`, for a case not in the table). -/
def treeOf (s : List Nat × List Nat) : CTree :=
  match treeTable.find? (·.1 == s) with
  | some p => p.2
  | none => .node []

end V2L
